// App-Target „Familiar“

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = $(FAMILIAR_BUNDLE_ID)
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/Familiar-Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Familiar
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
INFOPLIST_KEY_UIUserInterfaceStyle = Dark
INFOPLIST_KEY_NSCameraUsageDescription = Familiar nutzt die Kamera, um Fotos direkt an Aufgaben anzuhängen.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_PREVIEWS = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
CODE_SIGN_ENTITLEMENTS = Config/Familiar.entitlements
